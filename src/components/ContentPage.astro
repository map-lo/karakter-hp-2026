---
import { getEntry, render } from 'astro:content';
import OverlayLayout from '../layouts/OverlayLayout.astro';
import Prose from './Prose.astro';

interface Props {
  id: 'about' | 'imprint' | 'privacy';
}

const { id } = Astro.props;
const page = await getEntry('pages', id);
if (!page) throw new Error(`Missing required content page: ${id}`);
const { Content } = await render(page);
---

<OverlayLayout title={page.data.title} description={page.data.description}>
  <h1 class="display text-[clamp(2.5rem,7vw,5rem)]">{page.data.title}</h1>
  <Prose class="mt-14"><Content /></Prose>
</OverlayLayout>
