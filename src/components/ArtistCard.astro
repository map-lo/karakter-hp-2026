---
import { Image } from 'astro:assets';
import type { Artist } from '../lib/content';

interface Props {
	artist: Artist;
	eager?: boolean;
}

const { artist, eager = false } = Astro.props;

if (!artist.image) {
	throw new Error(
		`Missing portrait for "${artist.name}". Add src/assets/artists/${artist.slug}.jpg or run \`npm run artist-portraits\`.`
	);
}
---

<a
	href={artist.url}
	target="_blank"
	rel="noopener noreferrer"
	class="group block focus-visible:outline-none"
>
	<div class="relative overflow-hidden bg-line/60">
		<div class="aspect-4/5">
			<Image
				src={artist.image}
				alt={`Portrait of ${artist.name}`}
				widths={[400, 700, 1000]}
				sizes="(min-width: 1024px) 25vw, 50vw"
				loading={eager ? 'eager' : 'lazy'}
				class="h-full w-full object-cover transition-transform duration-700 ease-out group-hover:scale-[1.03]"
			/>
		</div>
	</div>
	<div class="mt-3 flex items-baseline justify-between gap-2 sm:mt-4 sm:gap-4">
		<h3 class="display text-lg sm:text-xl xl:text-2xl">{artist.name}</h3>
		<span
			class="label text-muted opacity-0 transition-opacity duration-300 group-hover:opacity-100 group-focus-visible:opacity-100"
			aria-hidden="true">↗</span
		>
	</div>
</a>
