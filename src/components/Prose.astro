---
interface Props {
  class?: string;
}
---

<div class:list={['prose text-xl leading-relaxed sm:text-2xl sm:leading-relaxed', Astro.props.class]}>
  <slot />
</div>

<style>
  @reference "../styles/global.css";

  .prose :global(> * + *) {
    margin-top: 1.5rem;
  }

  .prose :global(h2) {
    @apply label mb-5 text-black/50;
    margin-top: 3.5rem;
  }

  .prose :global(> h2:first-child) {
    margin-top: 0;
  }

  .prose :global(h3) {
    @apply font-medium;
  }

  .prose :global(a) {
    @apply underline underline-offset-4;
  }

  .prose :global(ul) {
    list-style: disc;
    padding-left: 1.5em;
  }

  .prose :global(ol) {
    list-style: decimal;
    padding-left: 1.5em;
  }

  .prose :global(li + li) {
    margin-top: 0.5rem;
  }

  .prose :global(blockquote) {
    border-left: 2px solid currentColor;
    padding-left: 1em;
  }
</style>
