---
import type { Release } from "../lib/releases";
import { createPlaceholder } from "../lib/releases";

interface Props {
  release: Release;
  href?: string;
  index?: number;
  eager?: boolean;
}

const { release, href, index = 0, eager = false } = Astro.props;
const target = release.url ?? href;
const Tag = target ? "a" : "div";
---

<article
  class="release-item relative aspect-square overflow-hidden bg-neutral-900 border-[0.5px] border-black/40"
  data-artist={release.artist.toLowerCase()}
  data-title={release.title}
>
  <Tag
    class="block size-full text-inherit no-underline"
    href={target}
    target={target ? "_blank" : undefined}
    rel={target ? "noopener noreferrer" : undefined}
    title={`${release.title} — ${release.artist}`}
  >
    <img
      class="block size-full object-cover"
      src={release.artwork}
      alt={`${release.title} by ${release.artist}`}
      width="300"
      height="300"
      loading="eager"
      decoding="async"
      data-fallback={createPlaceholder(release.title, index)}
    />
  </Tag>
</article>
