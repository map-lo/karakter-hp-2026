---
import { Font } from 'astro:assets';
import '../styles/global.css';

interface Props {
	title?: string;
	description?: string;
	chrome?: boolean;
}

const {
	title,
	description = 'KARAKTER is an artist management company based in Berlin and London.',
	chrome = true
} = Astro.props;

const pageTitle = title ? `${title} — Karakter Worldwide` : 'Karakter Worldwide — Artist Management';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';

const nav = [
	{ href: '/', label: 'Artists' },
	{ href: '/about', label: 'About' }
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<title>{pageTitle}</title>
		<Font cssVariable="--font-inter-tight" preload />
		<Font cssVariable="--font-inter-family" preload />
	</head>
	<body class:list={['min-h-screen', { 'flex flex-col': chrome }]}>
		{
			chrome && (
				<header class="px-6 pt-8 pb-10 sm:px-10 md:px-14 md:pt-12">
					<div class="flex flex-wrap items-baseline justify-between gap-x-10 gap-y-4">
						<a href="/" class="label font-medium">Karakter Worldwide</a>
						<nav class="flex gap-6 sm:gap-8">
							{nav.map((item) => (
								<a
									href={item.href}
									class:list={[
										'label transition-colors hover:text-ink',
										path === item.href ? 'text-ink' : 'text-muted'
									]}
									aria-current={path === item.href ? 'page' : undefined}
								>
									{item.label}
								</a>
							))}
						</nav>
					</div>
				</header>
			)
		}

		<main class:list={{ 'flex-1': chrome }}>
			<slot />
		</main>

		{
			chrome && (
				<footer class="mt-32 border-t border-line px-6 py-10 sm:px-10 md:px-14">
					<div class="flex flex-col gap-8 md:flex-row md:items-end md:justify-between">
						<div class="max-w-xs text-sm leading-relaxed text-muted">
							<p class="text-ink">Karakter Worldwide GmbH</p>
							<p>Skalitzer Strasse 67, 10997 Berlin, Germany</p>
							<p class="mt-3">
								<a
									class="underline-offset-4 hover:underline"
									href="mailto:info@karakter-worldwide.com"
								>
									info@karakter-worldwide.com
								</a>
							</p>
							<p>
								<a
									class="underline-offset-4 hover:underline"
									href="https://www.instagram.com/karaktermanagement/"
									target="_blank"
									rel="noopener noreferrer"
								>
									@karaktermanagement
								</a>
							</p>
						</div>
						<nav class="flex flex-wrap gap-x-6 gap-y-2">
							<a class="label text-muted transition-colors hover:text-ink" href="/about">About</a>
							<a class="label text-muted transition-colors hover:text-ink" href="/privacy">Privacy</a>
							<a class="label text-muted transition-colors hover:text-ink" href="/imprint">Imprint</a>
						</nav>
					</div>
				</footer>
			)
		}
	</body>
</html>
