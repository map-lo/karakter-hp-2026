---
import OverlayLayout from '../layouts/OverlayLayout.astro';
import Prose from '../components/Prose.astro';
import { imprint } from '../lib/content';
---

<OverlayLayout title="Imprint" description="Imprint and disclaimer of Karakter Worldwide GmbH.">
	<h1 class="display text-[clamp(2.5rem,7vw,5rem)]">Imprint</h1>
	<Prose text={imprint} class="mt-14 text-xl leading-relaxed sm:text-2xl sm:leading-relaxed" />
</OverlayLayout>
