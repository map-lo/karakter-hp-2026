---
import Layout from "../layouts/Layout.astro";
import ReleaseCard from "../components/ReleaseCard.astro";
import { artists } from "../lib/content";
import { releases } from "../lib/releases";

const artistByName = new Map(
  artists.map((artist) => [artist.name.toLowerCase(), artist]),
);
const sortedArtists = [...artists].sort((a, b) =>
  a.name.localeCompare(b.name, "en", { sensitivity: "base" }),
);
---

<Layout chrome={false}>
  <div class="min-h-screen bg-paper">
    <aside
      class="flex flex-col bg-paper px-5 pt-6 pb-8 text-ink min-[1024px]:fixed min-[1024px]:inset-y-0 min-[1024px]:left-0 min-[1024px]:z-20 min-[1024px]:min-h-svh min-[1024px]:w-[38%] min-[1024px]:overflow-y-auto min-[1024px]:p-[clamp(1.5rem,3vw,3rem)]"
    >
      <div
        class="flex flex-col gap-2 min-[1024px]:gap-[clamp(0.5rem,1vh,0.85rem)]"
      >
        <h1>
          <a
            class="font-inter bg-ink text-paper text-[2rem] leading-none font-black tracking-[-0.045em] px-2 py-1 lowercase no-underline min-[1024px]:text-[clamp(1.75rem,3.8vh,2.75rem)]"
            href="/"
            aria-label="Karakter Worldwide, home">Karakter</a
          >
        </h1>
        <!-- <p
          class="max-w-58 font-sans text-[clamp(1rem,3vw,1.25rem)] leading-[1.1] font-medium tracking-[-0.035em] min-[1024px]:text-[clamp(0.9rem,1.9vh,1.35rem)]"
        >
          Artist management from Berlin and London.
        </p> -->
      </div>

      <nav
        id="artists"
        class="mt-12 min-[1024px]:mt-0 min-[1024px]:flex min-[1024px]:flex-1 min-[1024px]:flex-col min-[1024px]:justify-center"
        aria-label="Artist roster"
      >
        <ol
          class="grid grid-cols-1 gap-y-1 min-[1024px]:gap-y-[clamp(0.15rem,0.4vh,0.5rem)]"
        >
          {
            sortedArtists.map((artist, i) => (
              <li>
                <a
                  class="roster-link"
                  href={artist.url}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {i + 1}__{artist.name.replace(/\s+/g, "_")}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div
        class="mt-12 flex items-center justify-between gap-4 border-t border-ink/22 pt-6 min-[1024px]:mt-auto min-[1024px]:border-t-0 min-[1024px]:pt-4"
      >
        <div class="flex flex-wrap items-start justify-start gap-2">
          <a
            class="contact-link"
            href="mailto:info@karakter-worldwide.com"
            aria-label="Email Karakter Worldwide"
          >
            <svg class="contact-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M2.5 5.5h19v13h-19z"></path>
              <path d="m3 6 9 7 9-7"></path>
            </svg>
          </a>
          <a
            class="contact-link"
            href="https://www.instagram.com/karaktermanagement/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Karakter Worldwide on Instagram"
          >
            <svg class="contact-icon" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <circle
                class="fill-current stroke-none"
                cx="17.5"
                cy="6.5"
                r="1.2"></circle>
            </svg>
          </a>
        </div>
        <nav
          class="site-links hidden text-[0.76rem] min-[1024px]:flex min-[1024px]:text-[clamp(0.76rem,1.2vh,0.9rem)] [&_a:hover]:opacity-[0.68] [&_a:focus-visible]:opacity-[0.68]"
          aria-label="Site"
        >
          <a href="/about">About</a>
          <a href="/privacy">Privacy</a>
          <a href="/imprint">Imprint</a>
        </nav>
      </div>
    </aside>
    <section
      class="relative overflow-hidden bg-wall p-0 text-wall-ink min-[1024px]:ml-[38%] min-[1024px]:flex min-[1024px]:min-h-svh min-[1024px]:w-[62%] min-[1024px]:flex-col"
      aria-label="Releases"
    >
      <div
        class="relative z-2 m-0 grid grid-cols-[repeat(6,1fr)] gap-0 min-[1024px]:flex-1 min-[1024px]:[align-content:start]"
      >
        {
          releases.map((release, index) => (
            <ReleaseCard
              release={release}
              href={artistByName.get(release.artist.toLowerCase())?.url}
              index={index}
              eager={index < 10}
            />
          ))
        }
      </div>
    </section>

    <footer class="bg-wall px-5 py-8 text-wall-ink min-[1024px]:hidden">
      <nav class="site-links gap-6 text-[0.78rem]" aria-label="Site">
        <a href="/about">About</a>
        <a href="/privacy">Privacy</a>
        <a href="/imprint">Imprint</a>
      </nav>
    </footer>
  </div>

  <script>
    document
      .querySelectorAll<HTMLImageElement>("img[data-fallback]")
      .forEach((image) => {
        image.addEventListener(
          "error",
          () => {
            const fallback = image.dataset.fallback;
            if (fallback && image.src !== fallback) image.src = fallback;
          },
          { once: true },
        );
      });
  </script>
</Layout>

<style>
  @reference "../styles/global.css";

  @layer components {
    .roster-link {
      @apply flex lowercase py-[0.5rem] font-inter text-[clamp(1rem,4vw,3rem)] leading-[1.2] font-black tracking-tight text-inherit no-underline hover:text-[#e43d30] focus-visible:text-[#e43d30];
    }

    @media (min-width: 1024px) {
      .roster-link {
        padding-block: clamp(0.2rem, 0.45vh, 0.6rem);
        font-size: clamp(1em, 3vh, 2rem);
        line-height: 1.15;
      }
    }

    .site-links {
      @apply flex flex-wrap items-start justify-start gap-4;
    }

    .site-links a {
      @apply font-sans font-medium tracking-[-0.02em] text-inherit no-underline;
    }

    .contact-link {
      @apply inline-grid place-items-center font-sans text-[0.76rem] font-medium tracking-[-0.02em] text-ink no-underline hover:opacity-[0.68] focus-visible:opacity-[0.68];
    }

    .contact-icon {
      @apply size-[1.15rem] fill-none stroke-current;
      stroke-linecap: square;
      stroke-linejoin: miter;
      stroke-width: 1.9;
    }
  }
</style>
