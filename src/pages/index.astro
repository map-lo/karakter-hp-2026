---
import Layout from "../layouts/Layout.astro";
import ReleaseCard from "../components/ReleaseCard.astro";
import { artists } from "../lib/content";
import { releases } from "../lib/releases";

const artistByName = new Map(
  artists.map((artist) => [artist.name.toLowerCase(), artist]),
);
---

<Layout chrome={false}>
  <div class="home-shell">
    <aside class="info-panel">
      <div class="panel-top">
        <h1>
          <a class="wordmark" href="/" aria-label="Karakter Worldwide, home"
            >Karakter</a
          >
        </h1>
        <p class="management-line">Artist management from Berlin and London.</p>
      </div>

      <nav id="artists" class="roster" aria-label="Artist roster">
        <p class="section-label">Artists</p>
        <ol>
          {
            artists.map((artist, index) => (
              <li>
                <a href={artist.url} target="_blank" rel="noopener noreferrer">
                  <span>{String(index + 1).padStart(2, "0")}</span>
                  {artist.name}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="panel-footer">
        <div class="contact-links">
          <a href="mailto:info@karakter-worldwide.com">Email</a>
          <a
            href="https://www.instagram.com/karaktermanagement/"
            target="_blank"
            rel="noopener noreferrer">Instagram</a
          >
        </div>
        <nav class="site-links" aria-label="Site">
          <a href="/about">About</a>
          <a href="/privacy">Privacy</a>
          <a href="/imprint">Imprint</a>
        </nav>
      </div>
    </aside>

    <section class="media-wall" aria-label="Releases">
      <p class="wall-note">Releases</p>
      <div class="release-grid">
        {
          releases.map((release, index) => (
            <ReleaseCard
              release={release}
              href={artistByName.get(release.artist.toLowerCase())?.url}
              index={index}
              eager={index < 10}
            />
          ))
        }
      </div>
    </section>
  </div>

  <script>
    document
      .querySelectorAll<HTMLImageElement>("img[data-fallback]")
      .forEach((image) => {
        image.addEventListener(
          "error",
          () => {
            const fallback = image.dataset.fallback;
            if (fallback && image.src !== fallback) image.src = fallback;
          },
          { once: true },
        );
      });
  </script>
</Layout>

<style>
  .home-shell {
    min-height: 100vh;
    background: #292929;
  }

  .info-panel {
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    padding: clamp(1.5rem, 3vw, 3rem);
    background: #292929;
    color: #f2eee5;
  }

  .panel-top {
    display: flex;
    flex-direction: column;
    gap: clamp(2.5rem, 6vh, 5rem);
  }

  .panel-footer,
  .contact-links,
  .site-links {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
  }

  .wordmark {
    color: inherit;
    font-family: Impact, Haettenschweiler, "Arial Narrow Bold", sans-serif;
    font-size: clamp(3.1rem, 6.3vw, 6.8rem);
    font-stretch: condensed;
    font-weight: 900;
    letter-spacing: -0.045em;
    line-height: 0.78;
    text-decoration: none;
    text-transform: uppercase;
  }

  .management-line {
    max-width: 16rem;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(1rem, 1.3vw, 1.25rem);
    font-style: italic;
    line-height: 1.15;
  }

  .roster {
    margin-top: clamp(3rem, 7vh, 5.5rem);
  }

  .section-label {
    padding-bottom: 0.65rem;
    border-bottom: 1px solid rgb(242 238 229 / 0.35);
    font-family: "Arial Narrow", "Helvetica Neue", sans-serif;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .roster ol {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    column-gap: 1.5rem;
    margin-top: 0.65rem;
  }

  .roster a {
    display: flex;
    gap: 0.6rem;
    padding: 0.32rem 0;
    color: inherit;
    font-family: Georgia, "Times New Roman", serif;
    font-size: clamp(0.8rem, 1.05vw, 1rem);
    font-weight: 400;
    line-height: 1.1;
    text-decoration: none;
    transition: opacity 180ms ease;
  }

  .roster a:hover,
  .roster a:focus-visible {
    opacity: 0.5;
  }

  .roster a span {
    flex: none;
    font-family: "Arial Narrow", "Helvetica Neue", sans-serif;
    font-size: 0.55rem;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.06em;
    color: #e43d30;
    opacity: 1;
  }

  .panel-footer {
    align-items: flex-end;
    margin-top: auto;
    padding-top: 4rem;
  }

  .contact-links,
  .site-links {
    flex-wrap: wrap;
    justify-content: flex-start;
  }

  .panel-footer a {
    color: inherit;
    font-family: "Arial Narrow", "Helvetica Neue", sans-serif;
    font-size: 0.63rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-decoration: none;
    text-transform: uppercase;
  }

  .panel-footer a:hover,
  .panel-footer a:focus-visible {
    text-decoration: underline;
    text-underline-offset: 0.3rem;
  }

  .media-wall {
    position: relative;
    padding: clamp(2rem, 3.2vw, 3.5rem);
    overflow: hidden;
    background:
      radial-gradient(circle at 92% 3%, rgb(40 75 196 / 0.16), transparent 18%),
      radial-gradient(circle at 2% 46%, rgb(228 61 48 / 0.16), transparent 17%),
      linear-gradient(150deg, #efece2 0%, #d8d5c9 54%, #e8e3d6 100%);
    color: #0c0c0c;
  }

  .release-grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(7.5rem, 1fr));
    gap: clamp(0.55rem, 1vw, 0.9rem);
    margin-top: clamp(1rem, 2vw, 1.5rem);
  }

  .media-wall::before {
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.13'/%3E%3C/svg%3E");
    content: "";
    mix-blend-mode: multiply;
    opacity: 0.48;
    pointer-events: none;
  }

  .media-wall::after {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(
      circle,
      rgb(10 10 10 / 0.16) 0.7px,
      transparent 0.9px
    );
    background-size: 5px 5px;
    content: "";
    mix-blend-mode: multiply;
    opacity: 0.22;
    pointer-events: none;
  }

  .wall-note {
    position: relative;
    z-index: 2;
    font-size: 0.65rem;
    font-weight: 700;
    font-family: "Arial Narrow", "Helvetica Neue", sans-serif;
    letter-spacing: 0.12em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .wall-note {
    padding-bottom: 0.6rem;
    border-bottom: 1px solid rgb(12 12 12 / 0.45);
  }

  @media (min-width: 1024px) {
    .info-panel {
      position: fixed;
      inset: 0 auto 0 0;
      z-index: 20;
      width: 38%;
      overflow-y: auto;
    }

    .media-wall {
      width: 62%;
      margin-left: 38%;
    }
  }

  @media (max-width: 1023px) {
    .info-panel {
      min-height: auto;
      padding: 1.5rem 1.25rem 2rem;
    }

    .wordmark {
      font-size: clamp(4rem, 20vw, 6.2rem);
    }

    .roster {
      margin-top: 3.5rem;
    }

    .roster a {
      font-size: 0.78rem;
    }

    .panel-footer {
      margin-top: 3rem;
      padding-top: 1.5rem;
      border-top: 1px solid rgb(242 238 229 / 0.35);
    }

    .media-wall {
      padding: 2rem 1.15rem 4rem;
    }
  }

  @media (max-width: 420px) {
    .roster ol {
      column-gap: 0.7rem;
    }

    .roster a {
      gap: 0.4rem;
      font-size: 0.69rem;
    }
  }
</style>
