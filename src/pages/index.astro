---
import Layout from '../layouts/Layout.astro';
import MediaTile from '../components/MediaTile.astro';
import { artists } from '../lib/content';
import { mediaItems } from '../lib/media';

const artistByName = new Map(artists.map((artist) => [artist.name.toLowerCase(), artist]));
---

<Layout chrome={false}>
	<div class="home-shell">
		<aside class="info-panel">
			<div class="panel-top">
				<a class="wordmark" href="/" aria-label="Karakter Worldwide, home">Karakter</a>
				<p class="location">Artist management<br />Berlin and London</p>
			</div>

			<div class="panel-intro">
				<h1>Distinct artists.<br />Long careers.</h1>
				<p>
					We work openly with artists and producers and find the right path for each of them.
				</p>
			</div>

			<nav id="artists" class="roster" aria-label="Artist roster">
				<p class="section-label">Artists</p>
				<ol>
					{
						artists.map((artist, index) => (
							<li>
								<a href={artist.url} target="_blank" rel="noopener noreferrer">
									<span>{String(index + 1).padStart(2, '0')}</span>
									{artist.name}
								</a>
							</li>
						))
					}
				</ol>
			</nav>

			<div class="panel-footer">
				<div class="contact-links">
					<a href="mailto:info@karakter-worldwide.com">Email</a>
					<a
						href="https://www.instagram.com/karaktermanagement/"
						target="_blank"
						rel="noopener noreferrer">Instagram</a
					>
				</div>
				<nav class="site-links" aria-label="Site">
					<a href="/about">About</a>
					<a href="/privacy">Privacy</a>
					<a href="/imprint">Imprint</a>
				</nav>
			</div>
		</aside>

		<section class="media-wall" aria-label="Recent artwork and behind the scenes">
			<p class="wall-note">Artwork, releases and moments from the roster</p>
			{
				mediaItems.map((item, index) => (
					<MediaTile
						item={item}
						artist={artistByName.get(item.artist.toLowerCase())}
						index={index}
					/>
				))
			}
			<p class="wall-end">Karakter Worldwide<br />Berlin and London</p>
		</section>
	</div>

	<script>
		document.querySelectorAll<HTMLImageElement>('img[data-fallback]').forEach((image) => {
			image.addEventListener(
				'error',
				() => {
					const fallback = image.dataset.fallback;
					if (fallback && image.src !== fallback) image.src = fallback;
				},
				{ once: true }
			);
		});
	</script>
</Layout>

<style>
	.home-shell {
		min-height: 100vh;
		background: #eee7d8;
	}

	.info-panel {
		display: flex;
		flex-direction: column;
		min-height: 100svh;
		padding: clamp(1.5rem, 3vw, 3rem);
		background: #d8f052;
		color: #171713;
	}

	.panel-top,
	.panel-footer,
	.contact-links,
	.site-links {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 1rem;
	}

	.wordmark {
		color: inherit;
		font-size: clamp(2rem, 4vw, 4rem);
		font-weight: 700;
		letter-spacing: -0.07em;
		line-height: 0.8;
		text-decoration: none;
	}

	.location {
		font-size: 0.7rem;
		font-weight: 650;
		letter-spacing: 0.1em;
		line-height: 1.25;
		text-align: right;
		text-transform: uppercase;
	}

	.panel-intro {
		margin-top: clamp(4rem, 9vh, 7rem);
	}

	.panel-intro h1 {
		max-width: 8ch;
		font-size: clamp(2.75rem, 5.3vw, 5.8rem);
		font-weight: 600;
		letter-spacing: -0.065em;
		line-height: 0.87;
	}

	.panel-intro p {
		max-width: 27rem;
		margin-top: 1.75rem;
		font-size: clamp(1rem, 1.4vw, 1.25rem);
		line-height: 1.35;
	}

	.roster {
		margin-top: clamp(4rem, 8vh, 7rem);
	}

	.section-label {
		padding-bottom: 0.65rem;
		border-bottom: 1px solid rgb(23 23 19 / 0.4);
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		text-transform: uppercase;
	}

	.roster ol {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		column-gap: 1.5rem;
		margin-top: 0.65rem;
	}

	.roster a {
		display: flex;
		gap: 0.6rem;
		padding: 0.32rem 0;
		color: inherit;
		font-size: clamp(0.76rem, 1vw, 0.95rem);
		font-weight: 620;
		line-height: 1.1;
		text-decoration: none;
		transition: opacity 180ms ease;
	}

	.roster a:hover,
	.roster a:focus-visible {
		opacity: 0.5;
	}

	.roster a span {
		flex: none;
		font-size: 0.58rem;
		font-variant-numeric: tabular-nums;
		letter-spacing: 0.06em;
		opacity: 0.5;
	}

	.panel-footer {
		align-items: flex-end;
		margin-top: auto;
		padding-top: 4rem;
	}

	.contact-links,
	.site-links {
		flex-wrap: wrap;
		justify-content: flex-start;
	}

	.panel-footer a {
		color: inherit;
		font-size: 0.63rem;
		font-weight: 700;
		letter-spacing: 0.11em;
		text-decoration: none;
		text-transform: uppercase;
	}

	.panel-footer a:hover,
	.panel-footer a:focus-visible {
		text-decoration: underline;
		text-underline-offset: 0.3rem;
	}

	.media-wall {
		position: relative;
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		grid-template-rows: repeat(64, minmax(18px, 3.5vw));
		padding: clamp(5rem, 8vw, 9rem) clamp(1.5rem, 4vw, 5rem) 12rem;
		overflow: hidden;
		background:
			radial-gradient(circle at 74% 11%, rgb(255 255 255 / 0.75), transparent 20%),
			linear-gradient(145deg, #eee7d8 0%, #d9e5df 47%, #ded4ef 100%);
		color: #171613;
	}

	.media-wall::before {
		position: absolute;
		inset: 0;
		background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 180 180' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='.9' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)' opacity='.13'/%3E%3C/svg%3E");
		content: '';
		opacity: 0.18;
		pointer-events: none;
	}

	.wall-note,
	.wall-end {
		position: relative;
		z-index: 2;
		font-size: 0.65rem;
		font-weight: 700;
		letter-spacing: 0.12em;
		line-height: 1.25;
		text-transform: uppercase;
	}

	.wall-note {
		grid-column: 9 / 13;
		grid-row: 1;
		text-align: right;
	}

	.wall-end {
		grid-column: 1 / 7;
		grid-row: 63;
		align-self: end;
		font-size: clamp(1.4rem, 3vw, 3.5rem);
		letter-spacing: -0.05em;
		line-height: 0.9;
		text-transform: none;
	}

	@media (min-width: 1024px) {
		.info-panel {
			position: fixed;
			inset: 0 auto 0 0;
			z-index: 20;
			width: 38%;
			overflow-y: auto;
		}

		.media-wall {
			width: 62%;
			margin-left: 38%;
		}
	}

	@media (max-width: 1023px) {
		.info-panel {
			min-height: auto;
			padding: 1.5rem 1.25rem 2rem;
		}

		.wordmark {
			font-size: clamp(2.8rem, 15vw, 5rem);
		}

		.panel-intro {
			margin-top: 6rem;
		}

		.panel-intro h1 {
			font-size: clamp(3.5rem, 16vw, 6.5rem);
		}

		.panel-intro p {
			max-width: 23rem;
			font-size: 1.05rem;
		}

		.roster {
			margin-top: 5rem;
		}

		.roster a {
			font-size: 0.78rem;
		}

		.panel-footer {
			margin-top: 3rem;
			padding-top: 1.5rem;
			border-top: 1px solid rgb(23 23 19 / 0.4);
		}

		.media-wall {
			grid-template-rows: repeat(64, minmax(12px, 5.8vw));
			padding: 5rem 1.15rem 8rem;
		}
	}

	@media (max-width: 420px) {
		.roster ol {
			column-gap: 0.7rem;
		}

		.roster a {
			gap: 0.4rem;
			font-size: 0.69rem;
		}

		.location {
			font-size: 0.58rem;
		}
	}
</style>
