---
import Layout from "../layouts/Layout.astro";
import SleeveCover from "../components/SleeveCover.astro";
import { artists } from "../lib/content";
import { releases } from "../lib/releases";

const artistByName = new Map(
  artists.map((artist) => [artist.name.toLowerCase(), artist]),
);
const sortedArtists = [...artists].sort((a, b) =>
  a.name.localeCompare(b.name, "en", { sensitivity: "base" }),
);
---

<Layout chrome={false}>
  <div class="min-h-screen bg-paper">
    <aside
      class="flex flex-col bg-paper px-5 pt-6 pb-8 text-ink min-[1024px]:fixed min-[1024px]:inset-y-0 min-[1024px]:left-0 min-[1024px]:z-20 min-[1024px]:min-h-svh min-[1024px]:w-[38%] min-[1024px]:overflow-y-auto min-[1024px]:p-[clamp(1.5rem,3vw,3rem)] min-h-screen justify-between"
    >
      <div
        class="flex flex-col gap-2 min-[1024px]:gap-[clamp(0.5rem,1vh,0.85rem)]"
      >
        <div class="brand-lockup relative inline-flex items-center self-start">
          {/* Logo SVG starting at the left edge of normal text flow */}
          <div
            class="brand-logo pointer-events-none relative z-0 shrink-0 select-none"
            aria-hidden="true"
          >
            <svg
              viewBox="0 0 953 728"
              class="size-full opacity-90"
              fill="url(#brand-palette)"
              xmlns="http://www.w3.org/2000/svg"
            >
              <defs>
                <linearGradient
                  id="brand-palette"
                  gradientUnits="userSpaceOnUse"
                  x1="0"
                  y1="0"
                  x2="0"
                  y2="728"
                >
                  <stop offset="0%" stop-color="#D32F2F"></stop>
                  <stop offset="27%" stop-color="#D32F2F"></stop>
                  <stop offset="27%" stop-color="#E67E22"></stop>
                  <stop offset="48%" stop-color="#E67E22"></stop>
                  <stop offset="48%" stop-color="#2E7D32"></stop>
                  <stop offset="65%" stop-color="#2E7D32"></stop>
                  <stop offset="65%" stop-color="#2980B9"></stop>
                  <stop offset="79%" stop-color="#2980B9"></stop>
                  <stop offset="79%" stop-color="#2980B9"></stop>
                  <stop offset="91%" stop-color="#F5F5DC"></stop>
                  <stop offset="91%" stop-color="#F5F5DC"></stop>
                  <stop offset="100%" stop-color="#F5F5DC"></stop>
                </linearGradient>
              </defs>
              <path
                d="M88.65 94.95c9.32 -17.5 27.43 -31.1 44.09 -41.19c20.65 -12.33 43.17 -21.93 65.66 -30.36c17.61 -6.51 36.44 -10.32 54.94 -13.27c28.92 -4.44 58.39 -6.65 87.61 -8c29.98 -1.34 60.05 -1.7 90.05 -1.5c45.51 0.38 90.97 1.95 136.42 4.23c78.42 4.06 156.74 10.15 234.92 17.54c38.4 3.71 76.8 7.6 115.14 11.95c9.16 1.02 18.31 2.19 27.47 3.16c-12.94 1.03 -25.99 1.77 -38.95 2.68l-345.36 23.13l-441.53 29.57c-10.15 0.69 -20.31 1.35 -30.46 2.06z"
              ></path>
              <path
                d="M83.26 102.49c3.21 -0.46 6.51 0.26 9.74 0.33l719.04 47.35c3.69 0.48 8.51 0.06 11.97 1.16c-2.99 -0.36 -6.02 0.3 -9.03 0.37l-652.11 45.75l-127.89 8.98c-1.54 0.08 -3.03 0.3 -4.58 0.21c7.62 -30.99 21.01 -59.83 39.27 -85.97c3.7 -5.33 7.59 -10.52 11.66 -15.57c0.68 -0.85 1.32 -1.71 1.93 -2.61z"
              ></path>
              <path
                d="M20.51 439.15c1.43 -0.35 2.55 -0.05 3.99 0l405.74 28.83l238.17 16.92c2.93 0.24 5.87 0.3 8.79 0.63c-4.82 0.39 -9.66 1 -14.48 1.43l-540.48 53.6c-18.58 1.83 -37.18 3.7 -55.76 5.52c0.78 -8.37 1.94 -15.66 -4.1 -22.52c-2.57 -3.07 -5.56 -3.42 -9.36 -3.58c-8.67 -0.07 -17.38 2 -26.07 2.19c-6.21 0.2 -8.82 -1.06 -13.84 -4.33c-11.65 -6.81 -15.51 -14.54 -11.37 -28.04c3.18 -9.55 6.86 -19.17 10.45 -28.59c2.73 -7.32 5.74 -14.72 8.32 -22.06z"
              ></path>
              <path
                d="M29.03 212.3c5.27 0.2 10.92 0.82 16.23 1.17l517.6 40.42l116.45 9.09c2.45 0.22 4.91 0.25 7.35 0.57c-8.64 0.74 -17.41 1.54 -26.07 2.26l-597.16 51.45c-10.7 0.87 -21.52 1.94 -32.22 2.71c-4.18 -5.05 -6.34 -8.83 -7.64 -15.36c-2.43 -12.04 -2.12 -25.43 -1.55 -37.66c0.58 -10.07 1.62 -20.14 2.86 -30.15c0.98 -8.29 2.46 -16.33 4.15 -24.5z"
              ></path>
              <path
                d="M66.15 553.09c1.13 0 2.24 0.04 3.37 0.11l752.48 39.31c4.28 0.06 8.96 0.71 13.16 0.74c-2.95 0.58 -6.1 0.18 -9.12 0.58l-679.77 45.82c-7.04 0.45 -14.1 0.99 -21.14 1.4c-0.44 -2.54 -0.98 -5.05 -1.62 -7.54c-2.22 -8.3 -4.61 -14.86 -11.42 -20.47c-5.51 -3.49 -10.91 -4.3 -16.98 -6.16c-8.28 -2.3 -12.39 -7.06 -12.56 -15.86c0 -8.42 5.12 -15.9 11.17 -21.32l1.55 -1.52c-5.99 0.47 -11.96 -0.74 -17.52 -2.93c-6.18 -2.64 -10.55 -5 -11.6 -12.16z"
              ></path>
              <path
                d="M37.91 326.15c4.43 0.76 8.98 1.13 13.44 1.74l415.22 50.73c2.74 0.32 5.2 0.77 7.99 0.62c-2 0.86 -3.74 0.94 -5.87 1.2l-152.89 18.21l-288.93 34.43c-1.36 0.14 -2.69 0.38 -4.07 0.41c4.57 -11.95 9.22 -23.93 13.81 -35.88c3.25 -8.44 6.47 -16.92 9.58 -25.41c2.41 -6.89 5.17 -15.08 5.91 -22.3c0.85 -11.86 -6.65 -16.62 -14.19 -23.75z"
              ></path>
              <path
                d="M328.55 665.77c13.99 0.61 28.05 1.34 42.05 1.99l566.73 27.2c5.15 0.35 10.52 0.34 15.63 0.61c-6.26 0.46 -12.66 0.9 -18.97 1.16l-518.97 26.69l-79.08 4.06c-1.55 -0.08 -2.7 0.56 -4.18 -0.09c-0.6 -12.13 -0.68 -24.29 -1.09 -36.42c-0.41 -8.39 -0.37 -16.96 -2.12 -25.2z"
              ></path>
              <path
                d="M125.69 652.44c1.46 -0.08 2.86 0.14 4.31 0.23l152.98 11.64c1.74 0.1 3.35 0.39 5.1 0.17c-7.34 4.59 -16.5 5.39 -23.97 9.6c-7.8 4.58 -15.09 9.78 -23.27 13.74c-12.49 6.33 -26.01 9.62 -39.6 12.61c-13.94 2.88 -30.32 5.59 -44.36 2.6c-22.84 -4.93 -30.36 -30.11 -31.19 -50.59z"
              ></path>
            </svg>
          </div>

          <h1
            class="brand-wordmark absolute left-1/2 top-1/2 z-10 whitespace-nowrap"
          >
            <a
              class="font-inter leading-none font-black tracking-[-0.045em] lowercase no-underline inline-block"
              href="/"
              aria-label="Karakter Worldwide, home">Karakter</a
            >
          </h1>
        </div>
      </div>

      <nav
        id="artists"
        class="mt-12 min-[1024px]:mt-0 min-[1024px]:flex min-[1024px]:flex-1 min-[1024px]:flex-col min-[1024px]:justify-center"
        aria-label="Artist roster"
      >
        <ol class="flex flex-col">
          {
            sortedArtists.map((artist, i) => (
              <li class="flex">
                <a
                  class="roster-link"
                  href={artist.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  data-artist-slug={artist.slug}
                  data-artist-name={artist.name.toLowerCase()}
                >
                  {i + 1}__{artist.name.replace(/\s+/g, "_")}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      {
        /* Bottom section: contact icons, liner notes, and unobtrusive site links */
      }
      <div class="mt-8 min-[1024px]:mt-auto pt-6 flex flex-col gap-4">
        {
          /* Contact links: Mail, Instagram, Spotify & Apple Music icons before about text */
        }
        <div class="flex items-center gap-4">
          <a
            class="contact-link"
            href="https://open.spotify.com/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Karakter Playlist on Spotify"
          >
            <svg
              class="contact-icon-solid"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                d="M12 0C5.373 0 0 5.373 0 12s5.373 12 12 12 12-5.373 12-12S18.627 0 12 0zm5.503 17.31c-.216.354-.678.468-1.032.252-2.825-1.728-6.381-2.119-10.569-1.162-.405.093-.811-.16-.903-.564-.093-.405.159-.811.564-.904 4.588-1.049 8.528-.604 11.688 1.346.354.216.468.678.252 1.032zm1.468-3.262c-.272.443-.852.585-1.295.313-3.234-1.988-8.163-2.563-11.987-1.402-.498.152-1.028-.133-1.18-.63-.151-.498.133-1.028.63-1.18 4.372-1.328 9.805-.688 13.52 1.603.443.272.584.853.312 1.296zm.126-3.411C15.225 8.358 8.847 8.146 5.154 9.267c-.593.18-1.222-.156-1.402-.75-.18-.593.156-1.222.75-1.402 4.242-1.288 11.286-1.042 15.753 1.61.534.317.708 1.01.392 1.544-.318.535-1.01.708-1.544.392z"
              ></path>
            </svg>
          </a>
          <a
            class="contact-link"
            href="https://music.apple.com/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Karakter Playlist on Apple Music"
          >
            <svg
              class="contact-icon-solid"
              viewBox="0 0 32 32"
              aria-hidden="true"
            >
              <path
                d="M 21.61 1.15 C 21.73 2.30 21.55 3.46 21.07 4.52 C 20.59 5.57 19.84 6.48 18.89 7.15 C 17.98 7.85 16.86 8.21 15.71 8.15 C 15.12 3.69 19.24 1.35 21.61 1.15 ZM 10.61 7.80 C 11.74 7.78 12.85 8.02 13.87 8.51 C 14.60 8.94 15.42 9.20 16.27 9.26 C 16.90 9.26 17.53 9.14 18.11 8.89 C 19.37 8.29 20.72 7.92 22.11 7.80 C 23.20 7.85 24.26 8.15 25.21 8.67 C 26.17 9.19 26.99 9.92 27.63 10.80 L 27.88 11.14 C 27.04 11.67 26.29 12.34 25.69 13.14 C 24.93 14.22 24.52 15.51 24.51 16.83 C 24.49 17.99 24.77 19.13 25.33 20.14 C 26.12 21.44 27.33 22.44 28.76 22.96 C 27.40 26.27 24.39 30.85 21.63 30.85 C 20.84 30.87 20.05 30.67 19.36 30.27 C 17.87 29.57 16.17 29.46 14.59 29.95 C 14.02 30.14 13.47 30.37 12.93 30.55 C 12.40 30.76 11.83 30.86 11.26 30.85 C 10.50 30.79 9.78 30.50 9.19 30.02 C 6.25 27.91 3.24 22.02 3.24 16.88 C 3.19 14.73 3.83 12.63 5.07 10.88 C 6.14 9.51 8.19 7.80 10.61 7.80 Z"
              ></path>
            </svg>
          </a>
          <a
            class="contact-link"
            href="mailto:info@karakter-worldwide.com"
            aria-label="Email Karakter Worldwide"
          >
            <svg class="contact-icon" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M2.5 5.5h19v13h-19z"></path>
              <path d="m3 6 9 7 9-7"></path>
            </svg>
          </a>
          <a
            class="contact-link"
            href="https://www.instagram.com/karaktermanagement/"
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Karakter Worldwide on Instagram"
          >
            <svg class="contact-icon" viewBox="0 0 24 24" aria-hidden="true">
              <rect x="3" y="3" width="18" height="18" rx="5"></rect>
              <circle cx="12" cy="12" r="4"></circle>
              <circle
                class="fill-current stroke-none"
                cx="17.5"
                cy="6.5"
                r="1.2"></circle>
            </svg>
          </a>
        </div>

        {
          /* Liner notes: Dimmed, compact about summary styled like CD back notes */
        }
        <div
          class="text-[0.62rem] sm:text-[0.68rem] min-[1024px]:text-[clamp(0.6rem,0.95vh,0.72rem)] leading-relaxed text-ink/40 font-mono tracking-tight max-w-[28rem]"
          aria-label="Liner notes"
        >
          <p class="leading-[1.45] text-balance">
            KARAKTER is an artist management company based in Berlin and London.
            Holistic management with an honest, long-term approach for artists
            with strong individual characters.
          </p>
        </div>

        {
          /* Footer links: styled like the short about text to avoid distraction */
        }
        <nav class="site-links hidden min-[1024px]:flex" aria-label="Site">
          <a href="/about">About</a>
          <a href="/privacy">Privacy</a>
          <a href="/imprint">Imprint</a>
        </nav>
      </div>
    </aside>

    {/* Right column / CD packaging presentation */}
    <section
      class="relative flex flex-col items-center justify-center overflow-x-hidden bg-wall px-6 py-12 text-wall-ink min-[1024px]:ml-[38%] min-[1024px]:min-h-svh min-[1024px]:w-[62%] min-[1024px]:p-8 xl:p-12"
      aria-label="Releases Packaging"
    >
      {/* CD presentation wrapper: sleeve + peaking CD */}
      <div
        class="relative flex w-full max-w-[840px] items-center justify-start py-8 min-[1024px]:py-0"
      >
        {
          /* The CD Disc peaking out ~25% from behind the right edge of the sleeve */
        }
        {
          /* Sleeve is 80% width, Disc is 76% width. Left position = 80% - (0.75 * 76%) = 23% */
        }
        {
          /* That places the disc right edge at exactly 23% + 76% = 99%, so 19% / 76% = 25.0% of the disc is exposed */
        }
        <div
          class="cd-disc absolute top-1/2 left-[23%] -translate-y-1/2 aspect-square w-[76%] rounded-full z-1"
          aria-hidden="true"
        >
          {/* Authentic CD image from untitled.stream */}
          <div
            class="cd-disc-element size-full rounded-full bg-contain bg-center bg-no-repeat drop-shadow-2xl transition-transform duration-700 ease-out"
            style="background-image: url('/assets/cd.webp');"
          >
          </div>
        </div>

        {/* The CD Packaging / Sleeve Backside */}
        <div
          class="cd-sleeve relative z-10 aspect-square w-[80%] bg-[#1c1c1c] text-[#f0f0ee] rounded-[3px] shadow-[0_22px_45px_-10px_rgba(0,0,0,0.55),0_8px_18px_-6px_rgba(0,0,0,0.35),inset_0_1px_1px_rgba(255,255,255,0.12)] flex items-center justify-center p-3 min-[1024px]:p-4 overflow-hidden border border-black/60 select-none"
        >
          {/* Subtle paper / cardboard sleeve texture & spine highlight */}
          <div
            class="pointer-events-none absolute inset-0 z-20 shadow-[inset_2px_0_4px_rgba(255,255,255,0.06),inset_-4px_0_8px_rgba(0,0,0,0.6)]"
            aria-hidden="true"
          >
          </div>

          {
            /* Scrollable release covers grid with snapping: exact aspect-square viewport so exactly 6 rows show */
          }
          <div
            class="sleeve-grid-viewport relative z-10 aspect-square w-full max-h-full overflow-y-auto overflow-x-hidden snap-y snap-mandatory scroll-smooth rounded-[2px] bg-black/40 shadow-inner no-scrollbar"
          >
            <div class="grid grid-cols-6 gap-1 w-full">
              {
                releases.map((release, index) => (
                  <div
                    class={`aspect-square ${index % 6 === 0 ? "snap-start" : ""}`}
                  >
                    <SleeveCover
                      release={release}
                      href={artistByName.get(release.artist.toLowerCase())?.url}
                      index={index}
                      eager={index < 18}
                    />
                  </div>
                ))
              }
            </div>
          </div>
        </div>
      </div>
    </section>

    <footer class="bg-wall px-5 py-8 text-wall-ink min-[1024px]:hidden">
      <nav class="site-links gap-6 text-[0.78rem]" aria-label="Site">
        <a href="/about">About</a>
        <a href="/privacy">Privacy</a>
        <a href="/imprint">Imprint</a>
      </nav>
    </footer>
  </div>

  <script>
    const rosterLinks =
      document.querySelectorAll<HTMLAnchorElement>(".roster-link");
    const releaseItems =
      document.querySelectorAll<HTMLElement>(".release-item");
    const cdDisc = document.querySelector<HTMLElement>(".cd-disc-element");
    const sleeveViewport = document.querySelector<HTMLElement>(
      ".sleeve-grid-viewport",
    );

    let currentRotation = 0;
    let activeArtist: string | null = null;
    let resetTimer: ReturnType<typeof setTimeout> | null = null;

    function scrollArtistIntoViewIfNeeded(artist: string) {
      if (!sleeveViewport) return;

      // Find all release items for this artist
      const matches: HTMLElement[] = [];
      releaseItems.forEach((item) => {
        if (item.dataset.artist === artist) {
          matches.push(item);
        }
      });

      if (matches.length === 0) return;

      const viewportRect = sleeveViewport.getBoundingClientRect();
      const padding = 4; // Tolerance in px

      // Check if at least one matching release is substantially visible
      const hasVisibleRelease = matches.some((item) => {
        const rect = item.getBoundingClientRect();
        return (
          rect.top >= viewportRect.top - padding &&
          rect.bottom <= viewportRect.bottom + padding
        );
      });

      // If no release for this artist is currently in view, scroll to the first one
      if (!hasVisibleRelease) {
        const target = matches[0];
        // Target's row container is its parent element inside the grid
        const rowItem =
          (target.closest(".snap-start") as HTMLElement) ||
          target.parentElement ||
          target;

        // Smoothly scroll the sleeve viewport to align with the target row
        const targetOffsetTop = rowItem.offsetTop;
        sleeveViewport.scrollTo({
          top: targetOffsetTop,
          behavior: "smooth",
        });
      }
    }

    function applyHighlight(artist: string | null) {
      if (!artist) {
        // Reset all release covers to neutral / resting state
        releaseItems.forEach((item) => {
          item.style.opacity = "1";
        });
        return;
      }

      // Highlight only items matching the hovered artist, dim others without changing size
      releaseItems.forEach((item) => {
        const itemArtist = item.dataset.artist;
        const isMatch = itemArtist === artist;
        item.style.opacity = isMatch ? "1" : "0.22";
      });

      // Scroll to the first active release if none is visible in the sleeve viewport
      scrollArtistIntoViewIfNeeded(artist);
    }

    const supportsHover = window.matchMedia(
      "(hover: hover) and (pointer: fine)",
    ).matches;

    rosterLinks.forEach((link) => {
      if (!supportsHover) return;
      link.addEventListener("mouseenter", () => {
        // Clear any pending reset timeout from a previous mouseleave
        if (resetTimer) {
          clearTimeout(resetTimer);
          resetTimer = null;
        }

        const artist = link.dataset.artistName;
        if (artist && artist !== activeArtist) {
          activeArtist = artist;

          // Slightly rotate the CD disc on hover
          currentRotation += 25;
          if (cdDisc) {
            cdDisc.style.transform = `rotate(${currentRotation}deg)`;
          }

          applyHighlight(artist);
        }
      });

      link.addEventListener("mouseleave", () => {
        // Use a short debounce delay (120ms) before clearing the highlight.
        // This ensures moving between adjacent items in the roster list
        // cross-fades smoothly without flickering back to all-neutral.
        if (resetTimer) {
          clearTimeout(resetTimer);
        }
        resetTimer = setTimeout(() => {
          activeArtist = null;
          applyHighlight(null);
          resetTimer = null;
        }, 120);
      });
    });

    // Also handle fallback image errors gracefully
    document
      .querySelectorAll<HTMLImageElement>("img[data-fallback]")
      .forEach((image) => {
        image.addEventListener(
          "error",
          () => {
            const fallback = image.dataset.fallback;
            if (fallback && image.src !== fallback) image.src = fallback;
          },
          { once: true },
        );
      });
  </script>
</Layout>

<style>
  @reference "../styles/global.css";

  @layer components {
    .brand-lockup {
      --brand-size: min(
        clamp(1.3125rem, 6vh, 4.5rem),
        calc((100vw - 2.5rem) / 5.25)
      );
      --logo-height: calc(var(--brand-size) * 23 / 16);
    }

    .brand-logo {
      width: calc(var(--logo-height) * 953 / 728);
      height: var(--logo-height);
    }

    .brand-wordmark {
      font-size: var(--brand-size);
      transform: translateY(-50%);
    }

    .brand-wordmark a {
      padding: 0.0556em 0.1111em;
    }

    .roster-link {
      @apply inline-flex w-fit lowercase font-inter font-black tracking-tight text-inherit no-underline hover:text-[#e43d30] focus-visible:text-[#e43d30] transition-colors duration-150;
      /* Padding is em-based so the vertical rhythm scales with the type at every size */
      font-size: clamp(1.125rem, 7vw, 2.25rem);
      line-height: 1.15;
      padding-block: 0.18em;
    }

    @media (min-width: 1024px) {
      .brand-lockup {
        --brand-size: min(
          clamp(1.3125rem, 6vh, 4.5rem),
          calc((38vw - 2 * clamp(1.5rem, 3vw, 3rem)) / 5.25)
        );
      }

      .roster-link {
        font-size: clamp(1.25rem, 3vh, 2rem);
      }
    }

    .site-links {
      @apply flex flex-wrap items-center gap-x-4 gap-y-1 text-[0.62rem] sm:text-[0.68rem] min-[1024px]:text-[clamp(0.6rem,0.95vh,0.72rem)];
    }

    .site-links a {
      @apply font-mono tracking-tight text-inherit opacity-45 no-underline hover:opacity-85 focus-visible:opacity-85 transition-opacity;
    }

    .contact-link {
      @apply inline-grid place-items-center font-sans text-[0.76rem] font-medium tracking-[-0.02em] text-ink no-underline hover:opacity-[0.68] focus-visible:opacity-[0.68];
    }

    .contact-icon {
      @apply size-[2rem] fill-none stroke-current;
      stroke-linecap: square;
      stroke-linejoin: miter;
      stroke-width: 1.9;
    }

    .contact-icon-solid {
      @apply size-[2rem] fill-current;
    }

    .release-item {
      transition: opacity 0.25s ease;
    }

    /* Clean scrollbar for sleeve release viewport while maintaining CD aesthetic */
    .sleeve-grid-viewport {
      overflow-x: hidden;
    }

    .sleeve-grid-viewport::-webkit-scrollbar {
      width: 3px;
